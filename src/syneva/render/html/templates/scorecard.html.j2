{% if not fragment -%}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>syneva scorecard</title>
<style>
  body { font: 14px/1.4 system-ui, sans-serif; max-width: 980px; margin: 2rem auto; color: #222; }
  h1 { border-bottom: 2px solid #444; padding-bottom: .3em; }
  h2 { margin-top: 2rem; color: #2b5; }
  .summary { display: flex; gap: 1rem; flex-wrap: wrap; margin-bottom: 1.5rem; }
  .summary .card { background: #f4f6f8; padding: .8rem 1rem; border-radius: 6px; min-width: 11rem; max-width: 15rem; flex: 1; }
  .summary .card .label { font-size: 11px; text-transform: uppercase; color: #666; letter-spacing: .05em; }
  .summary .card .score { font-size: 1.6rem; font-weight: 600; }
  .metric { border: 1px solid #ddd; border-radius: 6px; padding: 1rem; margin-bottom: 1rem; }
  .metric-header { display: flex; justify-content: space-between; align-items: center; }
  .metric-header .badge { font-size: 12px; padding: 2px 8px; border-radius: 999px; background: #eef5ff; }
  .metric-failed { background: #fff5f5; border-color: #f99; }
  .metric-failed .badge { background: #fee; color: #a00; }
  table { width: 100%; border-collapse: collapse; margin-top: .5rem; font-size: 13px; }
  th, td { border-bottom: 1px solid #eee; padding: 4px 8px; text-align: left; }
  img.plot { display: block; max-width: 100%; margin-top: .8rem; }
  .code { display: inline-block; font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
          font-size: 11px; color: #667; background: #eef; padding: 1px 6px; border-radius: 4px; margin-top: 2px; }
  .metric-desc { font-size: 13px; color: #555; margin: .4rem 0 .2rem; }
  .metric-score { margin: .6rem 0 .2rem; }
  .metric-score .score-value { font-size: 1.7rem; font-weight: 700; color: #333; }
  .metric-score .score-max { font-size: 12px; color: #999; margin-left: 3px; }
  .metric-score .score-note { font-size: 12px; color: #777; margin-left: 8px; }
  .modeline { font-size: 12px; color: #667; background: #f4f6f8; padding: .5rem .8rem; border-radius: 6px; }
  .raw-hint { font-size: 12px; color: #777; font-style: italic; margin: .3rem 0 0; }
  .verdict { font-size: 11px; font-weight: 700; padding: 2px 9px; border-radius: 999px;
             margin-left: 8px; vertical-align: middle; text-transform: uppercase; letter-spacing: .03em; }
  .v-excellent { background: #d6f5e0; color: #1a7f43; }
  .v-good { background: #e2f0d9; color: #3d7a1f; }
  .v-fair { background: #fff3cd; color: #8a6d00; }
  .v-poor { background: #fde2e2; color: #a32020; }
  .v-skipped { background: #e9ecef; color: #555; margin-left: 0; }
  .metric-skipped { background: #fafafa; border-style: dashed; }
  .skip-reason { font-size: 13px; color: #555; margin: .4rem 0 0; }
  details.details { margin-top: .5rem; }
  details.details summary { font-size: 11px; text-transform: uppercase; letter-spacing: .05em;
                            color: #999; cursor: pointer; }
  .card .card-desc { font-size: 11px; color: #667; margin-top: .4rem; line-height: 1.3; }
  .meta { font-size: 12px; color: #666; margin-top: 2rem; border-top: 1px solid #eee; padding-top: 1rem; }
</style>
</head>
<body>
{%- endif %}
  <h1>syneva scorecard</h1>
  <p class="subtitle">7 Cs framework — synthetic tabular data evaluation</p>
  {% if score_mode == "actual" %}
    <p class="modeline">Showing <strong>actual measured statistics</strong> per metric. The summary below is the normalized 0&ndash;1 roll-up.</p>
  {% else %}
    <p class="modeline">Showing <strong>normalized scores</strong> (0&ndash;1, higher is better). Switch to "Actual measured values" for raw statistics.</p>
  {% endif %}

  <div class="summary">
    {% for card in summary_cards %}
      <div class="card">
        <div class="label">{{ card.c|capitalize }}</div>
        <div class="score">{{ "%.2f"|format(card.score) }}</div>
        <span class="verdict {{ card.verdict_class }}">{{ card.verdict_label }}</span>
        {% if card.info %}<div class="card-desc">{{ card.info }}</div>{% endif %}
      </div>
    {% endfor %}
  </div>

  {% for c, results in by_c.items() %}
    <h2>{{ c|capitalize }}</h2>
    {% for r in results %}
      <div class="metric {% if r.error %}metric-failed{% elif r.skip_reason %}metric-skipped{% endif %}">
        <div class="metric-header">
          <strong>{{ r.display_name }}</strong>
          <span class="badge">{{ r.spec.tier }}</span>
        </div>
        <code class="code">{{ r.spec.name }}</code>
        {% if r.info %}<p class="metric-desc">{{ r.info }}</p>{% endif %}
        {% if r.error %}
          <p>error: {{ r.error }}</p>
        {% elif r.skip_reason %}
          <div class="metric-score"><span class="verdict v-skipped">Skipped</span></div>
          <p class="skip-reason"><strong>Why skipped:</strong> {{ r.skip_reason }}</p>
          {% if r.notes %}
            <p style="font-size:12px;color:#666">notes: {{ r.notes|join("; ") }}</p>
          {% endif %}
        {% elif score_mode == "actual" %}
          {% if r.detail_rows %}
            <div class="metric-score">
              <span class="score-value">{{ "%.4f"|format(r.detail_rows[0][1]) }}</span>
              <span class="score-note">{{ r.detail_rows[0][0] }}</span>
            </div>
            {% if r.detail_rows|length > 1 %}
              <table>
                {% for label, v in r.detail_rows[1:] %}
                  <tr><th>{{ label }}</th><td>{{ "%.4f"|format(v) }}</td></tr>
                {% endfor %}
              </table>
            {% endif %}
          {% else %}
            <p class="metric-desc">No separate raw statistic; normalized score = {{ "%.4f"|format(r.score) }}.</p>
          {% endif %}
          {% if r.raw_hint %}<p class="raw-hint">How to read it: {{ r.raw_hint }}</p>{% endif %}
        {% else %}
          {% if r.score is not none %}
            <div class="metric-score">
              <span class="score-value">{{ "%.2f"|format(r.score) }}</span><span class="score-max">/ 1.00</span>
              <span class="verdict {{ r.verdict_class }}">{{ r.verdict_label }}</span>
            </div>
          {% endif %}
          {% if r.detail_rows %}
            <details class="details">
              <summary>Technical details</summary>
              <table>
                {% for label, v in r.detail_rows %}
                  <tr><th>{{ label }}</th><td>{{ "%.4f"|format(v) }}</td></tr>
                {% endfor %}
              </table>
            </details>
          {% endif %}
          {% if r.plot_b64 %}
            <img class="plot" src="data:image/png;base64,{{ r.plot_b64 }}" alt="{{ r.spec.name }} plot">
          {% elif r.plot_html %}
            {{ r.plot_html|safe }}
          {% endif %}
          {% if r.notes %}
            <p style="font-size:12px;color:#666">notes: {{ r.notes|join("; ") }}</p>
          {% endif %}
        {% endif %}
      </div>
    {% endfor %}
  {% endfor %}

  <div class="meta">
    <p>syneva {{ run_info.library_versions.get('syneva', '?') }} ·
       random_state={{ run_info.random_state }} ·
       duration={{ "%.2f"|format((run_info.finished_at or 0) - run_info.started_at) }}s</p>
    {% if run_info.warnings %}<p>warnings: {{ run_info.warnings|join("; ") }}</p>{% endif %}
  </div>
{% if not fragment -%}
</body>
</html>
{%- endif %}
